# Firebase project ID used to validate Firebase ID-token audience and issuer.
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
# Comma-separated origins allowed to call the API. Use * only during local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Required for browser-to-private-R2 direct uploads. Do not commit real S3 credentials.
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET_NAME=medly-storage
R2_S3_ACCESS_KEY_ID=replace-with-r2-s3-access-key-id
R2_S3_SECRET_ACCESS_KEY=replace-with-r2-s3-secret-access-key
