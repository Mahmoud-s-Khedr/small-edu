{
  "name": "medly-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types ./worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply medly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply medly-db --remote",
    "seed:superadmin": "node scripts/seed-superadmin.mjs",
    "e2e:prepare": "node scripts/e2e-production.mjs prepare",
    "e2e:run": "node scripts/e2e-production.mjs run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.7.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
