{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medly-db",
      "database_id": "4e87f0a2-1902-4ed9-97f8-f461316d838a",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "medly-storage"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
